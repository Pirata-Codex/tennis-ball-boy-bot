# ---------------------------------------------------------------------------
# Tennis ball collector - DIRT / CLAY court
#
# Identical scene to worlds/tennis_court.wbt: same court, same net, same ten
# balls in the same places, same robot, same controller. What changes is the
# physics of the ground:
#
#   * rubber on loose clay loses grip, so the wheels slip. The controller
#     measures that (odometry vs GPS) and trims its commands, which is why no
#     per-world tuning constants are needed.
#   * a tennis ball on clay barely bounces and stops rolling almost at once.
#   * rolling resistance is much higher, so shoving a ball across the surface
#     costs far more than on acrylic.
#   * the intake roller/chute materials are IDENTICAL to the hard-court world
#     on purpose, so pickup quality is directly comparable between the two.
# ---------------------------------------------------------------------------

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/TennisBall.proto"
EXTERNPROTO "../protos/TennisCollectorRobot.proto"
EXTERNPROTO "../protos/CourtMarkings.proto"

WorldInfo {
  title "Tennis ball collector - dirt court"
  basicTimeStep 32
  randomSeed 1
  contactProperties [
    # ---- ball on clay: grippy, dead, stops rolling almost immediately ----
    ContactProperties {
      material1 "tennisBall"
      material2 "dirtFloor"
      coulombFriction [ 0.90 0.90 0.90 0.90 ]
      rollingFriction 0.060 0.060 0.020
      bounce 0.05
      bounceVelocity 0.02
    }
    # ---- drive wheels: less grip than on acrylic, plus real rolling
    #      resistance. This is what makes the robot slip. ----
    ContactProperties {
      material1 "wheel"
      material2 "dirtFloor"
      coulombFriction [ 0.72 0.72 0.72 0.72 ]
      rollingFriction 0.022 0.022 0.006
    }
    # ---- front skids sink slightly into the soft surface ----
    ContactProperties {
      material1 "skid"
      material2 "dirtFloor"
      coulombFriction [ 0.10 0.10 0.10 0.10 ]
      rollingFriction 0.012 0.012 0.004
    }
    # ---- intake: unchanged from the hard-court world on purpose ----
    ContactProperties {
      material1 "tennisBall"
      material2 "roller"
      coulombFriction [ 1.30 1.30 1.30 1.30 ]
      rollingFriction 0.004 0.004 0.001
    }
    ContactProperties {
      material1 "tennisBall"
      material2 "chute"
      coulombFriction [ 1.30 1.30 1.30 1.30 ]
      rollingFriction 0.004 0.004 0.001
    }
    ContactProperties {
      material1 "tennisBall"
      material2 "hopper"
      coulombFriction [ 0.75 0.75 0.75 0.75 ]
      rollingFriction 0.030 0.030 0.012
    }
    # ---- bodywork / rails, so a ball that clips the chassis behaves ----
    ContactProperties {
      material1 "tennisBall"
      material2 "chassis"
      coulombFriction [ 0.45 0.45 0.45 0.45 ]
      bounce 0.20
    }
    # ---- against the fence and the net (same in both worlds) ----
    ContactProperties {
      material1 "wheel"
      material2 "wall"
      coulombFriction [ 0.40 0.40 0.40 0.40 ]
    }
    ContactProperties {
      material1 "tennisBall"
      material2 "wall"
      coulombFriction [ 0.50 0.50 0.50 0.50 ]
      bounce 0.40
    }
    ContactProperties {
      material1 "tennisBall"
      material2 "net"
      coulombFriction [ 0.30 0.30 0.30 0.30 ]
      rollingFriction 0.020 0.020 0.010
    }
  ]
}


# ---- static overview camera ----
# Kept as a second viewpoint, so it can still be picked from the viewpoint list,
# for looking at the whole court.
Viewpoint {
  description  "overview"
  orientation 1 0 0 0.85
  position    -2 -12 8
}

# ---- chase camera (the default) ----
# `follow` names a DEF'd node and makes Webots keep this viewpoint locked to it,
# so the camera tracks the robot with no controller code. "Tracking Shot" moves
# the camera but leaves its ORIENTATION fixed in world space, so the horizon
# stays level; a camera that rotated with the robot's heading would roll the
# whole court on every turn, which makes a small robot on a 12 m court very
# hard to follow. followSmoothness damps the motion so the view glides instead
# of snapping every step.
Viewpoint {
  description        "chase"
  orientation        0.36 0.20 0.91 2.30
  position           -7.7 -2.2 1.7
  follow             "ROBOT"
  followType         "Tracking Shot"
  followSmoothness   0.85
  fieldOfView        0.70
}
TexturedBackground {
}
TexturedBackgroundLight {
}

# ================= SURFACE =================
Solid {
  name "floor"
  translation 0 0 -0.05
  contactMaterial "dirtFloor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.62 0.32 0.18
        metalness 0
        roughness  1.0
      }
      geometry Box { size 30 24 0.1 }
    }
  ]
  boundingObject Box { size 30 24 0.1 }
}

CourtMarkings {
  dropZoneCenter -4.9 1.8 0
  lineColor      0.92 0.90 0.84
}

# ================= PERIMETER FENCE =================
Solid {
  name "wallNorth"
  translation 0  3.3 0.6
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.27 0.32 metalness 0 roughness 0.9 }
      geometry Box { size 13.0 0.2 1.2 }
    }
  ]
  boundingObject Box { size 13.0 0.2 1.2 }
}
Solid {
  name "wallSouth"
  translation 0 -3.3 0.6
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.27 0.32 metalness 0 roughness 0.9 }
      geometry Box { size 13.0 0.2 1.2 }
    }
  ]
  boundingObject Box { size 13.0 0.2 1.2 }
}
Solid {
  name "wallEast"
  translation  6.3 0 0.6
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.27 0.32 metalness 0 roughness 0.9 }
      geometry Box { size 0.2 6.8 1.2 }
    }
  ]
  boundingObject Box { size 0.2 6.8 1.2 }
}
Solid {
  name "wallWest"
  translation -6.3 0 0.6
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.27 0.32 metalness 0 roughness 0.9 }
      geometry Box { size 0.2 6.8 1.2 }
    }
  ]
  boundingObject Box { size 0.2 6.8 1.2 }
}

# ================= NET =================
Solid {
  name "netMesh"
  translation 0 0 0.525
  contactMaterial "net"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.90 0.92 0.95
        metalness 0
        roughness  0.9
        transparency 0.78
      }
      geometry Box { size 0.02 6.4 0.85 }
    }
  ]
  boundingObject Box { size 0.02 6.4 0.85 }
}
Solid {
  name "netTapeTop"
  translation 0 0 0.91
  contactMaterial "net"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.97 0.97 0.97 metalness 0 roughness 0.8 }
      geometry Box { size 0.05 6.4 0.06 }
    }
  ]
  boundingObject Box { size 0.05 6.4 0.06 }
}
Solid {
  name "netTapeBottom"
  translation 0 0 0.10
  contactMaterial "net"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.97 0.97 0.97 metalness 0 roughness 0.8 }
      geometry Box { size 0.05 6.4 0.05 }
    }
  ]
  boundingObject Box { size 0.05 6.4 0.05 }
}
Solid {
  name "postNorth"
  translation 0  3.15 0.55
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.20 0.22 0.26 metalness 0.4 roughness 0.5 }
      geometry Cylinder { radius 0.05 height 1.1 }
    }
  ]
  boundingObject Cylinder { radius 0.05 height 1.1 }
  physics Physics { density -1 mass 8 }
}
Solid {
  name "postSouth"
  translation 0 -3.15 0.55
  contactMaterial "wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.20 0.22 0.26 metalness 0.4 roughness 0.5 }
      geometry Cylinder { radius 0.05 height 1.1 }
    }
  ]
  boundingObject Cylinder { radius 0.05 height 1.1 }
  physics Physics { density -1 mass 8 }
}

# ================= TENNIS BALLS =================
# Heavier damping than the hard-court world: a ball dropped on clay does not
# wander, it just sits where it lands, which also makes it easier to line up on.
DEF BALL0 TennisBall { name "ball0" translation -4.7  0.50 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL1 TennisBall { name "ball1" translation -4.3 -1.90 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL2 TennisBall { name "ball2" translation -3.5  0.30 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL3 TennisBall { name "ball3" translation -2.7  2.10 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL4 TennisBall { name "ball4" translation -1.9 -0.80 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL5 TennisBall { name "ball5" translation -1.2  1.40 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL6 TennisBall { name "ball6" translation -3.9 -0.30 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL7 TennisBall { name "ball7" translation -2.4 -2.20 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL8 TennisBall { name "ball8" translation -1.5 -1.60 0.0335 linearDamping 0.55 angularDamping 0.80 }
DEF BALL9 TennisBall { name "ball9" translation -5.4 -0.80 0.0335 linearDamping 0.55 angularDamping 0.80 }

# ================= ROBOT =================
DEF ROBOT TennisCollectorRobot {
  translation -5.3 -2.2 0
  controller  "tennis_collector"
  controllerArgs [ "--dropZone -4.9 1.8 --bounds -5.75 -0.70 -2.70 2.70" ]
}