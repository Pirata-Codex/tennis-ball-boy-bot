#VRML_SIM R2025a utf8
WorldInfo { title "step check" basicTimeStep 32 }
Viewpoint { position 0 -4 2 orientation 1 0 0 1.2 }
Background { skyColor [ 0.4 0.7 1 ] }
Solid {
  name "floor"
  translation 0 0 -0.05
  children [ Shape { geometry Box { size 20 20 0.1 } } ]
  boundingObject Box { size 20 20 0.1 }
  physics Physics { }
}
DEF BALL0 Solid {
  name "ball0"
  translation 2 0 0.0335
  children [ Shape { geometry Sphere { radius 0.0335 } } ]
  boundingObject Sphere { radius 0.0335 }
  physics Physics { density -1 mass 0.057 }
}
Robot {
  supervisor TRUE
  controller "steptest"
  boundingObject Box { size 0.002 0.002 0.002 }
  physics Physics { density -1 mass 0.05 }
  children [
    DEF BODY_CHASSIS Solid {
      name "chassis"
      children [
        HingeJoint {
          jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0 0 }
          device RotationalMotor {
            name "leftWheelMotor" maxTorque 14 maxVelocity 20
            minPosition -1e6 maxPosition 1e6
          }
          endPoint DEF BODY_WHEEL_LEFT Solid {
            name "wheelLeft"
            translation -0.10 0.185 0.09
            children [
              Transform { rotation 1 0 0 1.5708
                children [ Shape { geometry Cylinder { radius 0.09 height 0.05 } } ] }
            ]
            boundingObject Transform { rotation 1 0 0 1.5708
              children [ Cylinder { radius 0.09 height 0.05 } ] }
            physics Physics { density -1 mass 0.7 }
          }
        }
        Transform {
          translation 0.02 0 0.06
          children [ Shape { geometry Box { size 0.36 0.30 0.06 } } ]
        }
      ]
      boundingObject Box { size 0.36 0.30 0.06 }
      physics Physics { density -1 mass 12 }
    }
  ]
}